# Copy to .env, then replace each example secret.
DATABASE_URL=postgres://messagepusher:change-db-password@localhost:5432/messagepusher
POSTGRES_PASSWORD=CHANGE_TO_A_STRONG_ALPHANUMERIC_PASSWORD
HTTP_PORT=8080
BIND_ADDRESS=0.0.0.0:8080
PUBLIC_BASE_URL=https://push.example.com
# Generate 32 random bytes and encode as Base64: openssl rand -base64 32
CONFIG_KEY_BASE64=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
# Use a different random secret: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
RUST_LOG=messagepusher=info
# Number of simultaneously running delivery tasks (1–128).
WORKER_CONCURRENCY=32
# Maximum PostgreSQL connections in this process (4–128).
DATABASE_MAX_CONNECTIONS=24
